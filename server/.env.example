PORT=5000
NODE_ENV=development
AGENT_DEMO_MODE=true
CLIENT_URL=http://localhost:5173

# MongoDB is not required for the hackathon Agent Demo mode.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRE=30d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for the real Gemini agent. Keep this server-side and never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
